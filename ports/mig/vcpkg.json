{
  "name": "mig",
  "version": "1.0.0",
  "description": "Motion Input Grid C++20 recognition engine",
  "homepage": "https://github.com/Robin-G0/MIG",
  "license": "Apache-2.0",
  "supports": "(windows & !uwp) | linux",
  "default-features": ["format", "hands"],
  "dependencies": [
    {"name": "vcpkg-cmake", "host": true},
    {"name": "vcpkg-cmake-config", "host": true}
  ],
  "features": {
    "format": {"description": "JSON motion profiles", "dependencies": ["nlohmann-json"]},
    "hands": {"description": "Hand gesture recognition"},
    "c-api": {"description": "Shared C ABI", "dependencies": [{"name": "mig", "features": ["format"]}]}
  }
}
